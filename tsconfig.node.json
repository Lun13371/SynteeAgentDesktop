{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["electron.vite.config.*", "src/main/**/*", "src/preload/**/*", "src/core/**/*", "src/shared/**/*"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "target": "ES2022",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@main/*": ["src/main/*"],
      "@core/*": ["src/core/*"],
      "@shared/*": ["src/shared/*"]
    }
  }
}
